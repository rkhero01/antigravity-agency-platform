# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Antigravity Agency Management & AI Intelligence Platform
# Task 28 — Step 5: Production Environment Variables & Secure Placeholders
# ==============================================================================
# IMPORTANT:
# - Operating in DEMO / SANDBOX mode by default.
# - DO NOT commit real secrets or production keys to version control.
# - Real external execution remains blocked until configured on secure backend.
# ==============================================================================

# --- Node.js Backend Server Configuration ---
PORT=5000
NODE_ENV=development
APP_ENV=development
API_BASE_URL=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- Database & Persistence Layer (PostgreSQL / Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Leave empty to operate in In-Memory Demo Sandbox mode
DATABASE_URL=

# --- Authentication & Session Security ---
# Use a high-entropy 256-bit secret in production
JWT_SECRET=demo-secret-key-change-in-production-2026!
JWT_EXPIRES_IN=7d
WEBHOOK_SECRET=demo-webhook-hmac-secret-key-2026!

# --- Frontend Client Configuration (Vite) ---
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_ENV=development
VITE_AI_EXECUTION_MODE=DEMO

# --- External Provider Placeholders (Production Server Only - Safely Blocked in Demo) ---

# Meta WhatsApp Business Cloud API
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_WEBHOOK_SECRET=
META_GRAPH_API_VERSION=v20.0

# Meta Ads API
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=

# Google Ads API Integration
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# CRM Gateway & Lead Integration
CRM_API_BASE_URL=https://api.crm-gateway.internal
CRM_API_KEY=

# SEO Crawler & SERP API
SEO_SERP_API_URL=
SEO_SERP_API_KEY=

# Financial Payment Gateway (Stripe / Razorpay)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# AI Engine / LLM Inference Gateway
AI_INFERENCE_GATEWAY_URL=https://api.ai-inference.internal
AI_INFERENCE_API_KEY=
